{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Test Full Workflow",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/test_full_workflow.py",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Udio Status",
      "type": "python",
      "request": "launch",
      "module": "udio_downloader",
      "args": ["status"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
