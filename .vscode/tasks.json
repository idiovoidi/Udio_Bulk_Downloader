{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clear Chrome Debug Profile",
      "type": "shell",
      "command": "if exist .chrome-debug-profile rmdir /s /q .chrome-debug-profile",
      "windows": {
        "command": "if exist .chrome-debug-profile rmdir /s /q .chrome-debug-profile"
      },
      "linux": {
        "command": "rm -rf .chrome-debug-profile"
      },
      "osx": {
        "command": "rm -rf .chrome-debug-profile"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Start Chrome with Remote Debugging (Temp Profile)",
      "type": "shell",
      "command": "start chrome --remote-debugging-port=9222 --user-data-dir=\"${workspaceFolder}/.chrome-debug-profile\" --load-extension=\"${workspaceFolder}/chrome_extension\"",
      "windows": {
        "command": "start chrome --remote-debugging-port=9222 --user-data-dir=\"${workspaceFolder}/.chrome-debug-profile\" --load-extension=\"${workspaceFolder}/chrome_extension\""
      },
      "linux": {
        "command": "google-chrome --remote-debugging-port=9222 --user-data-dir=\"${workspaceFolder}/.chrome-debug-profile\" --load-extension=\"${workspaceFolder}/chrome_extension\" &"
      },
      "osx": {
        "command": "open -a 'Google Chrome' --args --remote-debugging-port=9222 --user-data-dir=\"${workspaceFolder}/.chrome-debug-profile\" --load-extension=\"${workspaceFolder}/chrome_extension\""
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Start Chrome with Remote Debugging (Keep Login)",
      "type": "shell",
      "command": "start chrome --remote-debugging-port=9222 --user-data-dir=\"${workspaceFolder}/.chrome-debug-persistent\" --load-extension=\"${workspaceFolder}/chrome_extension\"",
      "windows": {
        "command": "start chrome --remote-debugging-port=9222 --user-data-dir=\"${workspaceFolder}/.chrome-debug-persistent\" --load-extension=\"${workspaceFolder}/chrome_extension\""
      },
      "linux": {
        "command": "google-chrome --remote-debugging-port=9222 --user-data-dir=\"${workspaceFolder}/.chrome-debug-persistent\" --load-extension=\"${workspaceFolder}/chrome_extension\" &"
      },
      "osx": {
        "command": "open -a 'Google Chrome' --args --remote-debugging-port=9222 --user-data-dir=\"${workspaceFolder}/.chrome-debug-persistent\" --load-extension=\"${workspaceFolder}/chrome_extension\""
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Start Chrome with Remote Debugging (Your Profile)",
      "type": "shell",
      "command": "start chrome.exe --remote-debugging-port=9222 --load-extension=\"${workspaceFolder}/chrome_extension\"",
      "windows": {
        "command": "start chrome.exe --remote-debugging-port=9222 --load-extension=\"${workspaceFolder}/chrome_extension\""
      },
      "linux": {
        "command": "google-chrome-stable --remote-debugging-port=9222 --load-extension=\"${workspaceFolder}/chrome_extension\" &"
      },
      "osx": {
        "command": "/Applications/Google\\ Chrome.app/Contents/MacOS/Google\\ Chrome --remote-debugging-port=9222 --load-extension=\"${workspaceFolder}/chrome_extension\" &"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Start Edge with Remote Debugging (Your Profile)",
      "type": "shell",
      "command": "start msedge.exe --remote-debugging-port=9222 --load-extension=\"${workspaceFolder}/chrome_extension\"",
      "windows": {
        "command": "start msedge.exe --remote-debugging-port=9222 --load-extension=\"${workspaceFolder}/chrome_extension\""
      },
      "linux": {
        "command": "microsoft-edge-stable --remote-debugging-port=9222 --load-extension=\"${workspaceFolder}/chrome_extension\" &"
      },
      "osx": {
        "command": "/Applications/Microsoft\\ Edge.app/Contents/MacOS/Microsoft\\ Edge --remote-debugging-port=9222 --load-extension=\"${workspaceFolder}/chrome_extension\" &"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Reload Extension",
      "type": "shell",
      "command": "echo Extension reloaded - refresh chrome://extensions manually",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
