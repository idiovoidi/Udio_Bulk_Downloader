{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "udio_downloader: status",
      "type": "debugpy",
      "request": "launch",
      "module": "udio_downloader",
      "args": ["status"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "udio_downloader: download (visible browser)",
      "type": "debugpy",
      "request": "launch",
      "module": "udio_downloader",
      "args": ["download", "--no-headless"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "udio_downloader: import-metadata (prompt for file)",
      "type": "debugpy",
      "request": "launch",
      "module": "udio_downloader",
      "args": ["import-metadata", "--json-file", "${input:exportFile}"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "dev_tools: map_folder_recursive",
      "type": "debugpy",
      "request": "launch",
      "module": "udio_downloader.dev_tools.map_folder_recursive",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    { "id": "exportFile", "type": "promptString", "description": "Path to udio_metadata_<date>.json" }
  ]
}
