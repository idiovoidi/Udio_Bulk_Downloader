{
  "enabled": true,
  "name": "Markdown Docs Organizer",
  "description": "Monitors creation of .md files and moves them to .docs folder while ensuring they contain only crucial, essential information",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new markdown file has been created. Please:\n1. Move this file to the .docs folder (create the folder if it doesn't exist)\n2. Review the content and ensure it contains ONLY crucial, essential information\n3. Remove any verbose or unnecessary content - documentation should be minimal and used sparingly\n4. Ensure the file follows the principle of documenting only what is absolutely necessary\n5. Confirm the file has been moved and optimized"
  }
}